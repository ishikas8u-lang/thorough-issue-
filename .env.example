# ==============================================================================
# Campus Assist Backend Configuration (.env.example)
# DO NOT COMMIT REAL SECRETS OR SENSITIVE DATA.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Database Configuration (SQLite database path)
DATABASE_PATH=backend/data/campus_assist.db

# CORS Configuration
# Comma-separated list of allowed frontend origins (NO wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session & Security Settings
SESSION_SECRET_KEY=change_this_to_a_secure_random_64_char_string_in_production
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# Rate Limiting Settings (Requests per minute per IP)
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_REPORT_PER_MINUTE=10
RATE_LIMIT_LOOKUP_PER_MINUTE=30

# Staff Reviewer Demo Credentials (Pre-seeded for evaluation)
# In production, replace with enterprise LDAP/OIDC SSO integration
STAFF_DEMO_USERNAME=staff_vansh
STAFF_DEMO_SECRET=Staff@Reviewer2026
