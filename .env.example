# ==============================================================================
# Campus Assist Environment Configuration (.env.example)
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS.
# Copy this file to .env for local deployment: cp .env.example .env
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database Configuration (SQLite database path)
DATABASE_PATH=backend/data/campus_assist.db

# CORS Configuration
# Comma-separated list of allowed origins (or leave blank when serving unified app)
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Session & Security Settings
SESSION_SECRET_KEY=change_this_to_a_secure_random_64_char_string_in_production
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# Rate Limiting Settings (Requests per minute per IP)
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_REPORT_PER_MINUTE=10
RATE_LIMIT_LOOKUP_PER_MINUTE=30

# Frontend API Configuration (Default /api for unified single-service deployment)
VITE_API_BASE_URL=/api
